---
//@ts-ignore
import { execSync } from 'node:child_process';

// 1. ビルド時にGitのリモートURLを自動取得して `owner/repo` を抽出する関数
function getRepoFromGit(): string {
  try {
    // git config --get remote.origin.url でリモートURLを取得
    const url = execSync('git config --get remote.origin.url', { encoding: 'utf-8' }).trim();
    
    // 例: https://github.com/owner/repo.git または git@github.com:owner/repo.git
    // ここから owner/repo 部分を綺麗に抜き出す正規表現
    const match = url.match(/github\.com[:/]([^/]+)\/([^/.]+)(?:\.git)?/i);
    if (match && match[1] && match[2]) {
      return `${match[1]}/${match[2]}`;
    }
  } catch (e) {
    console.warn('GitリモートURLの取得に失敗しました。フォールバックを使用します。', e);
  }
  
  // 万が一Git情報が取れなかった場合のフォールバック（自分のデフォルト）
  return 'hilava999/tonefolio';
}

const repoName = getRepoFromGit();

//console.log('最終的に判定された repoName:', repoName); // ← これも確認
---

<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ToneFolio CMS</title>
</head>
<body>
  <!-- Sveltia CMS を手動初期化するための設定スクリプト -->
  <script define:vars={{ repoName }}>
    // ビルド時にGitから自動抽出されたリポジトリ名がここに埋め込まれます
    window.CMS_CONFIG = {
      backend: {
        name: 'github',
        repo: repoName, 
        branch: 'main',
        base_url: 'https://sveltia-cms-auth.migomasu356.workers.dev',
      },
    };
  </script>
  <script src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js" type="module"></script>
</body>
</html>