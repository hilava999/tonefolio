---
import { getEntry } from 'astro:content';

import '../css/base.css';

// 1. データ取得
// サイト全体設定 (settings) を取得
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;
const accentColor = settings?.theme?.accent_color || '#4a90e2';
const fontFamily = settings?.theme?.font === 'serif' 
  ? "'Shippori Mincho', serif"
  : "'Noto Sans JP', sans-serif";
---

<div class="h-menu-container" style={`--accent: ${accentColor}; font-family: ${fontFamily};`}>
    <div class="h-menu">
        <a href="/"><h1 class="logo">{settings?.siteTitle}</h1></a>
        <ul class="h-menu-list">
            <li><a href="/">Home</a></li>
            <li><a  href="/about">About</a></li>
            <li><a href="/works">Works</a></li>
        </ul>
    </div>

    <button class="menu-toggle" aria-label="Menu">
        <div class="menu-span">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </button>
</div>

<style>

body.menu-open {
  overflow: hidden;
}

.h-menu-container {
    position: relative;
}


.h-menu {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
}

.menu-toggle {
  border: none;
  cursor: pointer;
  position: relative;
}

.menu-span  span{
  display: block;
  width: 24px;
  height: 2px;
  background: #333;
  margin: 5px 0;
  transition: .3s;
  z-index: 9999;
}

.menu-span {
    position: fixed;
    top: 3%;
    right: 3%;
    z-index: 9999;
}

.menu-toggle.active {
    position: absolute;
    top: 3%;
    z-index: 9999;
}

.menu-toggle.active span:nth-child(1) {
  transform: rotate(45deg) translate(5px, 5px);
      position: absolute;
     z-index: 9999;
}

.menu-toggle.active span:nth-child(2) {
  opacity: 0;
}

.menu-toggle.active span:nth-child(3) {
  transform: rotate(-45deg) translate(6px, -6px);
    position: absolute;
     z-index: 9999;
}

.logo {
    display: inline-block;
    font-size: 28px;
    color: #000;
    padding: 1em 0;
}


    .h-menu {
        display: block;
        position: fixed;
        top: 0;
        right: -100%;
        height:100vh;
        width: 30%;
        flex-direction: column;
        padding: 50px 70px;
        transition: right .3s ease;
        z-index: 20;
        backdrop-filter: blur(8px);
        background-color:rgba(255, 255, 255, 0.4);
    }

    .h-menu-list {
      padding-bottom: 20px;
    }

    .h-menu-list li {
        font-size: 18px;
        margin: 1em 0;
    }

    .h-menu-list li:nth-child(1) a { transition-delay: 0.5s; }
    .h-menu-list li:nth-child(2) a { transition-delay: 0.8s; }
    .h-menu-list li:nth-child(3) a { transition-delay: 1.1s; }
    .h-menu-list li:nth-child(4) a { transition-delay: 1.4s; }

    .h-menu.active {
        right: 0;
    }

    @media (max-width: 800px) {
      .h-menu {
        width: 70%;
      }
    }

@media (max-width: 500px) {
    .h-menu {
        width: 90%;
        padding: 20px 30px;
      }

    .logo {
        font-size: 24px;
    }

}
</style>

<script>
  // 1. 要素を確実に取得し、HTML要素であることを明示する
  const toggle = document.querySelector(".menu-toggle") as HTMLElement;
  const nav = document.querySelector(".h-menu") as HTMLElement;

  // 2. 要素が存在する場合のみ処理を実行する（「!」や「if」でチェック）
  if (toggle && nav) {
    document.querySelectorAll(".h-menu-list a").forEach(link => {
      link.addEventListener("click", () => {
        nav.classList.remove("active");
        toggle.classList.remove("active");
        document.body.classList.remove("menu-open");
      });
    });

    toggle.addEventListener("click", () => {
      nav.classList.toggle("active");
      toggle.classList.toggle("active");
      document.body.classList.toggle("menu-open");
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node; // 型をNodeとして明示
      const isMenuOpen = nav.classList.contains("active");

      if (
        isMenuOpen &&
        !nav.contains(target) &&
        !toggle.contains(target)
      ) {
        nav.classList.remove("active");
        toggle.classList.remove("active");
        document.body.classList.remove("menu-open");
      }
    });
  }
</script>
